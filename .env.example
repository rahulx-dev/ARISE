# ==============================================================================
# ARISE Production Cloud Environment Variables
# ==============================================================================
# Create a free Supabase project at https://supabase.com
# Go to Project Settings -> API and paste your Project URL and Anon Public Key below:

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# BitLabs Publisher App Token (Optional - from BitLabs Publisher Dashboard)
EXPO_PUBLIC_BITLABS_API_TOKEN=your-bitlabs-app-token-here
